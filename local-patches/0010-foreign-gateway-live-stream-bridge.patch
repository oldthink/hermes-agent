+class _DesktopSessionEventBridge:
+    """Non-blocking loopback relay from a gateway turn to a running ``hermes serve`` Desktop backend (patch 0010).
+
+    Queues live stream deltas (``reasoning.delta``, ``message.delta``), interim commentary, tool lifecycle
+    events (``tool.generating``, ``tool.start``, ``tool.complete``), and turn boundaries (``message.start``,
+    ``message.complete``) onto a bounded background daemon thread that batches and POSTs them to the local
+    ``hermes serve`` instance discovered via ``gateway.host_rendezvous``. Never blocks the agent thread and
+    silently drops when no Desktop backend is listening.
+    """
+
+    _QUEUE_MAX = 4096
+    _STOP = object()
+    _ENDPOINT_TTL_S = 10.0
+
+    def __init__(self, session_id: str) -> None:
+        self.session_id = str(session_id or "").strip()
+        self._queue: "queue.Queue[Any]" = queue.Queue(maxsize=self._QUEUE_MAX)
+        self._tool_started_at: dict[str, float] = {}
+        self._endpoint_cache: tuple[float, Optional[tuple[str, str]]] = (0.0, None)
+        self._thread: Optional[threading.Thread] = None
+        if self.session_id:
+            self._thread = threading.Thread(
+                target=self._worker, daemon=True, name=f"desktop-bridge:{self.session_id[:16]}"
+            )
+            self._thread.start()
+
+    def _resolve_endpoint(self) -> Optional[tuple[str, str]]:
+        now = time.monotonic()
+        cached_at, cached = self._endpoint_cache
+        if now - cached_at < self._ENDPOINT_TTL_S:
+            return cached
+        result: Optional[tuple[str, str]] = None
+        with suppress(Exception):
+            from gateway import host_rendezvous as hr
+            from hermes_cli.plugins_activation import _serve_backend_record
+            from hermes_cli.url_utils import format_url_host
+
+            record = _serve_backend_record()
+            if record is not None and record.port:
+                token = hr.read_token(record.role)
+                if token:
+                    url = (
+                        f"http://{format_url_host(hr.dial_host(record))}:{record.port}"
+                        "/api/dashboard/foreign-session-event"
+                    )
+                    result = (url, token)
+        self._endpoint_cache = (now, result)
+        return result
+
+    def emit(self, event: str, payload: Optional[Dict[str, Any]] = None) -> None:
+        if not self.session_id or self._thread is None:
+            return
+        from tui_gateway.contracts import registry as _contracts
+        _contracts.check_payload(event, payload)  # STRICT -> raises; prod -> log-and-continue (receiver parity server.py:702)
+        item = {"event": event, "session_id": self.session_id, "payload": payload}
+        try:
+            self._queue.put_nowait(item)
+        except queue.Full:
+            with suppress(queue.Empty):
+                self._queue.get_nowait()
+            with suppress(queue.Full):
+                self._queue.put_nowait(item)
+
+    def on_turn_start(self) -> None:
+        self.emit("message.start", {})
+
+    def on_text_delta(self, text: Optional[str]) -> None:
+        if isinstance(text, str) and text:
+            self.emit("message.delta", {"text": text})
+
+    def on_reasoning_delta(self, text: Optional[str]) -> None:
+        if isinstance(text, str) and text:
+            self.emit("reasoning.delta", {"text": text})
+
+    def on_interim(self, text: str, *, already_streamed: bool = False) -> None:
+        if isinstance(text, str) and text.strip():
+            self.emit("message.interim", {"text": text, "already_streamed": bool(already_streamed)})
+
+    def on_tool_gen(self, name: str) -> None:
+        if name:
+            self.emit("tool.generating", {"name": str(name)})
+
+    def on_tool_start(self, call_id: str, tool_name: str, args: dict) -> None:
+        cid = str(call_id or "")
+        name = str(tool_name or "tool")
+        self._tool_started_at[cid] = time.time()
+        context = ""
+        labels = None
+        with suppress(Exception):
+            # suppress covers cold import, build_tool_preview and producer/skin failures —
+            # agent/display.py's internal try only wraps import + labels_for_call, not
+            # _get_skin()/override application (rationale: draft-fix-v3 Change 1).
+            from agent.display import build_tool_preview, tool_labels_for_call
+            context = build_tool_preview(name, args or {}, max_len=80) or ""
+            labels = [label.as_payload() for label in tool_labels_for_call(name, args or {})] or None
+        payload: Dict[str, Any] = {"tool_id": cid, "name": name, "context": context}
+        if labels:
+            payload["labels"] = labels
+        if isinstance(args, dict) and args:
+            payload["args"] = args
+        self.emit("tool.start", payload)
+
+    def on_tool_complete(self, call_id: str, tool_name: str, args: dict, result: Any) -> None:
+        cid = str(call_id or "")
+        name = str(tool_name or "tool")
+        started_at = self._tool_started_at.pop(cid, None)
+        duration_s = (time.time() - started_at) if started_at else None
+        payload: Dict[str, Any] = {"tool_id": cid, "name": name, "args": args if isinstance(args, dict) else {}}
+        if duration_s is not None:
+            payload["duration_s"] = duration_s
+        if isinstance(result, str):
+            try:
+                payload["result"] = json.loads(result)
+            except Exception:
+                payload["result"] = result
+        else:
+            payload["result"] = result
+        self.emit("tool.complete", payload)
+
+    def on_turn_complete(self, result: Dict[str, Any]) -> None:
+        if not isinstance(result, dict):
+            result = {}
+        final_text = str(result.get("final_response") or "")
+        payload: Dict[str, Any] = {
+            "text": final_text,
+            "response_previewed": bool(result.get("response_previewed", False)),
+            "response_transformed": bool(result.get("response_transformed", False)),
+            "status": ("interrupted" if result.get("interrupted")
+                       else "error" if (result.get("error") or result.get("failed")) else "complete"),
+        }
+        if result.get("error"):
+            payload["error"] = str(result["error"])
+        self.emit("message.complete", payload)
+
+    def close(self, timeout: float = 1.5) -> None:
+        if self._thread is None:
+            return
+        with suppress(queue.Full):
+            self._queue.put_nowait(self._STOP)
+        self._thread.join(timeout=timeout)
+        self._thread = None
+
+    def _worker(self) -> None:
+        import urllib.request
+        batch: list[Dict[str, Any]] = []
+        stop_seen = False
+        while not stop_seen:
+            try:
+                item = self._queue.get(timeout=0.5)
+            except queue.Empty:
+                continue
+            if item is self._STOP:
+                stop_seen = True
+            else:
+                batch.append(item)
+            # Coalesce rapid deltas occurring within a 25ms window into one HTTP POST
+            deadline = time.monotonic() + 0.025
+            while len(batch) < 64 and not stop_seen:
+                rem = deadline - time.monotonic()
+                if rem <= 0:
+                    break
+                try:
+                    nxt = self._queue.get(timeout=rem)
+                except queue.Empty:
+                    break
+                if nxt is self._STOP:
+                    stop_seen = True
+                    break
+                batch.append(nxt)
+            if not batch:
+                continue
+            ep = self._resolve_endpoint()
+            if ep is not None:
+                url, token = ep
+                # Merge consecutive deltas of the same event type to minimize frames
+                merged: list[Dict[str, Any]] = []
+                for ev in batch:
+                    if (
+                        merged
+                        and ev["event"] in ("message.delta", "reasoning.delta")
+                        and merged[-1]["event"] == ev["event"]
+                        and merged[-1]["session_id"] == ev["session_id"]
+                    ):
+                        merged[-1]["payload"] = {
+                            "text": str((merged[-1].get("payload") or {}).get("text") or "")
+                            + str((ev.get("payload") or {}).get("text") or "")
+                        }
+                    else:
+                        merged.append(ev)
+                try:
+                    req = urllib.request.Request(
+                        url,
+                        data=json.dumps({"events": merged}, default=str).encode("utf-8"),
+                        method="POST",
+                        headers={"Content-Type": "application/json", "X-Hermes-Session-Token": token},
+                    )
+                    with urllib.request.urlopen(req, timeout=1.5) as resp:  # noqa: S310 — loopback http
+                        resp.read()
+                except Exception:
+                    self._endpoint_cache = (0.0, None)
+            batch.clear()
+
