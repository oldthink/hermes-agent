+def broadcast_foreign_session_event(event: str, session_id: str, payload: dict | None = None) -> bool:
+    """Broadcast a live stream/tool event from an external gateway process (e.g. ``hermes gateway run``
+    handling a Discord/Telegram turn) to connected Desktop WebSocket clients (patch 0010).
+
+    Also tracks ``_foreign_running`` on matching resumed records in ``_sessions`` so ``session.active_list``
+    reports ``status="working"`` while the external turn is in flight and Desktop's 1.5s liveness poll
+    does not prematurely settle the streamed bubble.
+    """
+    sid_str = str(session_id or "").strip()
+    if not sid_str or not event:
+        return False
+    now = time.time()
+    matched_sids: list[str] = []
+    with _sessions_lock:
+        for rsid, sess in list(_sessions.items()):
+            if not isinstance(sess, dict) or sess.get("_finalized"):
+                continue
+            if _session_lookup_key(sess, fallback=rsid) == sid_str or rsid == sid_str:
+                matched_sids.append(rsid)
+                sess["last_active"] = now
+                if event in ("message.start", "reasoning.delta", "message.delta", "tool.start", "tool.generating"):
+                    sess["_foreign_running"] = True
+                    sess["_foreign_running_ts"] = now
+                elif event in ("message.complete", "error"):
+                    sess["_foreign_running"] = False
+    with _live_transports_lock:
+        targets = list(_live_transports)
+    if not targets:
+        return False
+    emit_ids = matched_sids or [sid_str]
+    for target_sid in emit_ids:
+        frame = _event_frame(event, target_sid, payload)
+        for transport in targets:
+            with contextlib.suppress(Exception):
+                transport.write(frame)
+    return True
+
