+@router.post("/api/dashboard/foreign-session-event")
+async def post_foreign_session_event(request: Request):
+    """Relay live stream/tool events from an external gateway process (``hermes gateway run``)
+    into connected Desktop WebSocket clients (patch 0010)."""
+    _require_token(request)
+    try:
+        body = await request.json()
+    except Exception:
+        body = {}
+    if not isinstance(body, dict):
+        return {"ok": False}
+    import sys
+    server = sys.modules.get("tui_gateway.server")
+    if server is None or not hasattr(server, "broadcast_foreign_session_event"):
+        return {"ok": False}
+    events = body.get("events")
+    if isinstance(events, list):
+        delivered = False
+        for item in events:
+            if isinstance(item, dict):
+                ev = str(item.get("event") or "").strip()
+                sid = str(item.get("session_id") or "").strip()
+                pl = item.get("payload") if isinstance(item.get("payload"), dict) else None
+                if ev and sid and server.broadcast_foreign_session_event(ev, sid, pl):
+                    delivered = True
+        return {"ok": True, "delivered": delivered}
+    ev = str(body.get("event") or "").strip()
+    sid = str(body.get("session_id") or "").strip()
+    pl = body.get("payload") if isinstance(body.get("payload"), dict) else None
+    delivered = bool(ev and sid and server.broadcast_foreign_session_event(ev, sid, pl))
+    return {"ok": True, "delivered": delivered}
+
