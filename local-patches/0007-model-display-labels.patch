+def _apply_model_labels(rows: list[dict]) -> None:
+    """Attach per-model display labels from ``model_labels.<provider>.<model>`` in config.yaml.
+
+    A model id stays the wire truth (routing, pricing, switching all key off it); the label is
+    display-only and exists because some ids are ambiguous to a human — e.g. the same
+    ``google/gemini-4-argon`` id serves both a flex (half-price) and a standard OpenRouter
+    endpoint, selected by ``provider_routing``, so the id alone cannot tell an operator which
+    rate they are picking. Shape: ``{"openrouter": {"<model id>": "<label>"}}``; providers
+    absent from the map keep raw ids.
+    """
+    try:
+        from hermes_cli.config import load_config_readonly
+
+        labels = load_config_readonly().get("model_labels") or {}
+    except Exception:  # noqa: BLE001 — a label map must never fail the catalog payload
+        return
+    if not isinstance(labels, dict) or not labels:
+        return
+    for row in rows:
+        slug = str(row.get("slug") or "")
+        entry = labels.get(slug) or labels.get(slug.lower())
+        if not isinstance(entry, dict) or not entry:
+            continue
+        label_map = {str(k): str(v) for k, v in entry.items() if str(k).strip() and str(v).strip()}
+        if not label_map:
+            continue
+        row["model_labels"] = label_map
+        # A labelled model is one the operator wants to SEE. OpenRouter's curated index rotates,
+        # so an id can be temporarily absent even though the endpoint serves it; inject it so the
+        # label never has a row to attach to. The id is still validated downstream
+        # (drop_unofferable_model_ids) — injection must not smuggle a malformed id past it.
+        models = row.get("models")
+        if isinstance(models, list):
+            have = {str(m).lower() for m in models}
+            extra = [mid for mid in label_map if mid.lower() not in have]
+            if extra:
+                row["models"] = [*models, *extra]
+                total = row.get("total_models")
+                if isinstance(total, int):
+                    row["total_models"] = total + len(extra)
+
+
