+        if isinstance(exc, tuple) and len(exc) > 1:  # onerror hands sys.exc_info()
+            exc = exc[1]
+        try:
+            # Unlink/rmdir need write on the CONTAINING dir, not the entry itself.
+            parent = _os.path.dirname(p)
