+    # child's exit is as silent as an unadopted one (t_695b4b52).
+    def _ensure_detached_sweeper(self) -> None:
+        with self._lock:
+            if self._detached_sweeper_thread is not None and self._detached_sweeper_thread.is_alive():
+                return
