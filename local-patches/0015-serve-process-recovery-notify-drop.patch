+def _recover_served_profile_process_checkpoints(process_registry) -> int:
+    """Replay every served profile's ``processes.json`` under its own scope.
+
+    Mirrors the multiplex gateway's ``_recover_secondary_process_checkpoints``
+    (gateway/run_startup.py): the launch profile's file is read first by
+    ``recover_from_checkpoint``, and a served secondary's checkpoint must be
+    re-read under that profile's scope or its background processes are never
+    re-adopted after a backend respawn.
+    """
+    try:
+        from hermes_cli.profiles import profiles_to_serve
+        from hermes_constants import get_hermes_home
+
+        launch_home = Path(get_hermes_home()).resolve()
+    except Exception:
+        _log.debug("served-profile checkpoint enumeration unavailable", exc_info=True)
+        return 0
+    recovered = 0
+    for _name, profile_home in profiles_to_serve(multiplex=True):
+        if Path(profile_home).resolve() == launch_home:
+            continue
+        try:
+            from gateway.run import _profile_runtime_scope
+
+            with _profile_runtime_scope(Path(profile_home), {}):
+                recovered += process_registry.recover_from_checkpoint()
+        except Exception:
+            _log.warning("Process checkpoint recovery for profile %r failed", _name, exc_info=True)
+    return recovered
+
